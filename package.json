{
  "name": "coop-plan",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "合伙有序：多人会签、阶段预算、采购执行、审计留痕与有依据的AI风险分析",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:workers": "wrangler dev --test-scheduled",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "demo": "node scripts/seed-demo.mjs",
    "configure:cloudflare": "node scripts/configure-cloudflare.mjs",
    "fixture:visual": "node scripts/export-demo-fixture.mjs",
    "test:mobile": "python3 tests/mobile_render.py",
    "test:password-ui": "python3 tests/password_visibility_render.py",
    "test:admin-ui": "node tests/admin-fixture.mjs && python3 tests/admin_render.py",
    "fixture:ai": "node tests/ai-browser-server.mjs --fixture-only",
    "test:operations-ui": "node tests/operations-fixture.mjs && python3 tests/operations_render.py",
    "backup:restore-drill": "node scripts/restore-drill.mjs",
    "check:bindings": "node scripts/verify-operations-bindings.mjs",
    "test:lightweight-ui": "node tests/mobile-fixture.mjs && node tests/admin-fixture.mjs && python3 tests/lightweight_ai_render.py",
    "test:ai-relay-ui": "node tests/admin-fixture.mjs && python3 tests/ai_relay_render.py",
    "test:supervision-ui": "python3 tests/supervision_render.py"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
